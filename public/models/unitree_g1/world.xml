<!-- VELA simulation world: the G1 humanoid plus objects to interact with.
     Angles are in radians (set by g1.xml's compiler). The robot's standing pose
     comes from g1.xml's "stand" keyframe and is applied in JavaScript. -->
<mujoco model="vela_world">
  <include file="g1.xml"/>

  <statistic center="0.4 0 0.6" extent="2.5"/>

  <default>
    <default class="prop">
      <geom friction="0.8 0.01 0.001" solref="0.004 1" condim="4"/>
    </default>
  </default>

  <asset>
    <material name="wood" rgba="0.55 0.38 0.24 1"/>
    <material name="red" rgba="0.9 0.22 0.25 1"/>
    <material name="blue" rgba="0.2 0.5 0.95 1"/>
    <material name="green" rgba="0.25 0.8 0.45 1"/>
    <material name="yellow" rgba="0.98 0.78 0.2 1"/>
    <material name="purple" rgba="0.65 0.45 0.95 1"/>
    <material name="white" rgba="0.9 0.92 0.95 1"/>
    <material name="steel" rgba="0.6 0.65 0.72 1"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" friction="0.9 0.01 0.001"/>

    <!-- Table in front of the robot -->
    <body name="table" pos="0.62 0 0">
      <geom name="table_top" type="box" size="0.28 0.42 0.02" pos="0 0 0.68" material="wood"/>
      <geom type="box" size="0.02 0.02 0.33" pos="0.24 0.38 0.33" material="wood"/>
      <geom type="box" size="0.02 0.02 0.33" pos="-0.24 0.38 0.33" material="wood"/>
      <geom type="box" size="0.02 0.02 0.33" pos="0.24 -0.38 0.33" material="wood"/>
      <geom type="box" size="0.02 0.02 0.33" pos="-0.24 -0.38 0.33" material="wood"/>
    </body>

    <!-- Objects on the table -->
    <body name="red_cube" pos="0.52 0.12 0.74" childclass="prop">
      <freejoint/><geom type="box" size="0.035 0.035 0.035" material="red" mass="0.2"/>
    </body>
    <body name="blue_cube" pos="0.6 -0.15 0.74" childclass="prop">
      <freejoint/><geom type="box" size="0.03 0.03 0.03" material="blue" mass="0.15"/>
    </body>
    <body name="green_ball" pos="0.7 0.25 0.74" childclass="prop">
      <freejoint/><geom type="sphere" size="0.035" material="green" mass="0.1"/>
    </body>
    <body name="yellow_can" pos="0.72 -0.02 0.76" childclass="prop">
      <freejoint/><geom type="cylinder" size="0.03 0.06" material="yellow" mass="0.3"/>
    </body>
    <body name="purple_mug" pos="0.48 -0.3 0.75" childclass="prop">
      <freejoint/><geom type="capsule" size="0.028 0.03" material="purple" mass="0.2"/>
    </body>

    <!-- Block tower to knock over -->
    <body name="tower_1" pos="1.25 0.55 0.03" childclass="prop"><freejoint/><geom type="box" size="0.08 0.04 0.03" material="white" mass="0.3"/></body>
    <body name="tower_2" pos="1.25 0.55 0.09" childclass="prop"><freejoint/><geom type="box" size="0.04 0.08 0.03" material="blue" mass="0.3"/></body>
    <body name="tower_3" pos="1.25 0.55 0.15" childclass="prop"><freejoint/><geom type="box" size="0.08 0.04 0.03" material="white" mass="0.3"/></body>
    <body name="tower_4" pos="1.25 0.55 0.21" childclass="prop"><freejoint/><geom type="box" size="0.04 0.08 0.03" material="blue" mass="0.3"/></body>
    <body name="tower_5" pos="1.25 0.55 0.27" childclass="prop"><freejoint/><geom type="box" size="0.08 0.04 0.03" material="white" mass="0.3"/></body>
    <body name="tower_6" pos="1.25 0.55 0.33" childclass="prop"><freejoint/><geom type="box" size="0.04 0.08 0.03" material="red" mass="0.3"/></body>

    <!-- Dominoes -->
    <body euler="0 0 -0.4636" name="domino_1" pos="1.1 -0.45 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="yellow" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_2" pos="1.2 -0.5 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="white" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_3" pos="1.3 -0.55 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="yellow" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_4" pos="1.4 -0.6 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="white" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_5" pos="1.5 -0.65 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="yellow" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_6" pos="1.6 -0.7 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="white" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_7" pos="1.7 -0.75 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="yellow" mass="0.08"/></body>
    <body euler="0 0 -0.4636" name="domino_8" pos="1.8 -0.8 0.08" childclass="prop"><freejoint/><geom type="box" size="0.012 0.04 0.08" material="red" mass="0.08"/></body>

    <!-- Ramp with a ball at the top -->
    <body name="ramp" pos="-0.1 -1.0 0">
      <geom type="box" size="0.4 0.15 0.01" pos="0 0 0.18" euler="0 0.42 0" material="steel"/>
      <geom type="box" size="0.03 0.15 0.17" pos="-0.33 0 0.17" material="steel"/>
    </body>
    <body name="ramp_stop" pos="1.0 -1.0 0">
      <geom type="box" size="0.03 0.25 0.06" pos="0 0 0.06" material="steel"/>
    </body>
    <body name="ramp_ball" pos="-0.3 -1.0 0.34" childclass="prop">
      <freejoint/><geom type="sphere" size="0.05" material="red" mass="0.5"/>
    </body>
  </worldbody>
</mujoco>
